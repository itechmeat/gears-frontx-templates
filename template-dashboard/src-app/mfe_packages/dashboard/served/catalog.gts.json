    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.grid_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "GridRender",
      "description": "Render of a grid widget: its presentation fields, closed.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.render.v1~"
        },
        {
          "type": "object",
          "required": [
            "columns"
          ],
          "properties": {
            "columns": {
              "type": "array",
              "minItems": 1,
              "description": "Displayed columns, in display order. Each describes one data position. The consistency checks are validated by cpt-frontx-dashboard-algo-widget-catalog-grid-checks.",
              "items": {
                "type": "object",
                "required": [
                  "key"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string",
                    "pattern": "^[a-z][a-z0-9_]{0,63}$",
                    "description": "Unique column key. column_groups[].members and row_color refer to this key."
                  },
                  "title": {
                    "type": "string",
                    "description": "Optional heading."
                  },
                  "width": {
                    "type": "integer",
                    "minimum": 1,
                    "description": "Optional width in pixels. The table is at least as wide as the sum of its column widths, counting 160 pixels for a column without one; a grid wider than its cell scrolls sideways inside it."
                  },
                  "format": {
                    "type": "object",
                    "additionalProperties": false,
                    "description": "Optional number format. notation applies to number-valued cells only: standard shows the full number and compact shows the abbreviated number of the host language.",
                    "properties": {
                      "notation": {
                        "enum": [
                          "standard",
                          "compact"
                        ]
                      }
                    }
                  },
                  "align": {
                    "enum": [
                      "start",
                      "end",
                      "center"
                    ],
                    "default": "start",
                    "description": "Optional alignment of the column body, in logical terms: start and end follow the writing direction of the host language."
                  },
                  "sortable": {
                    "type": "boolean",
                    "default": true,
                    "description": "Whether a click on the header sorts by this column. Without it, true."
                  },
                  "overflow": {
                    "enum": [
                      "wrap",
                      "truncate"
                    ],
                    "default": "wrap",
                    "description": "wrap shows the whole value on as many lines as it needs; truncate keeps one line per cell, ends a long value in an ellipsis and keeps its full text as the cell's title. Without it, wrap."
                  }
                }
              }
            },
            "page_sizes": {
              "type": "array",
              "minItems": 1,
              "uniqueItems": true,
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 500
              },
              "default": [
                10,
                25,
                50,
                100,
                500
              ],
              "description": "Optional page sizes offered. The first entry is the initial page size. Defaults to [10, 25, 50, 100, 500]."
            },
            "frozen_columns": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of leading columns that stay visible during horizontal scrolling. 0 or absent freezes no column. More than the column count freezes all."
            },
            "column_groups": {
              "type": "array",
              "description": "Grouped column headings. A heading only: it never reorders rows or collapses columns.",
              "items": {
                "type": "object",
                "required": [
                  "title",
                  "members"
                ],
                "additionalProperties": false,
                "properties": {
                  "title": {
                    "type": "string"
                  },
                  "members": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string",
                      "pattern": "^[a-z][a-z0-9_]{0,63}$",
                      "description": "A column key."
                    }
                  }
                }
              }
            },
            "row_color": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$",
              "description": "Optional column key. Its value in a row names the row colour: success, warning, error, or info."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.cartesian_chart_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "CartesianChartRender",
      "description": "Render of a cartesian_chart widget: its presentation fields, closed.",
      "allOf": [
        {
          "$ref": "gts://gts.frontx.dashboard.widget.render.v1~"
        },
        {
          "type": "object",
          "properties": {
            "series": {
              "type": "array",
              "description": "How each data series is drawn. A data series without an entry here draws as bars on the primary y axis.",
              "items": {
                "type": "object",
                "required": [
                  "name",
                  "type"
                ],
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "description": "The series name, matching a series name in the data."
                  },
                  "type": {
                    "enum": [
                      "bar",
                      "line",
                      "area",
                      "scatter"
                    ],
                    "description": "How the series is drawn."
                  },
                  "y_axis": {
                    "enum": [
                      "primary",
                      "secondary"
                    ],
                    "default": "primary",
                    "description": "Which y axis the series uses. Without it, the primary axis."
                  },
                  "stack_group": {
                    "type": "string",
                    "description": "Optional stack group. Series with the same stack group on the same y axis are stacked in delivered order: bars and areas together, lines together."
                  },
                  "label": {
                    "type": "string",
                    "description": "A line or area only: a name written at the end of the series, at its last point, for example a target."
                  },
                  "line_style": {
                    "enum": [
                      "solid",
                      "dashed"
                    ],
                    "default": "solid",
                    "description": "A line or area only. Without it, solid."
                  }
                }
              }
            },
            "x_axis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "category",
                    "value",
                    "time"
                  ],
                  "default": "category",
                  "description": "Without it, category."
                },
                "label": {
                  "type": "string",
                  "description": "A title written under the x axis ticks, and the x column heading of the data view and the text alternative."
                },
                "tick_labels": {
                  "enum": [
                    "auto",
                    "every"
                  ],
                  "default": "auto",
                  "description": "auto skips tick labels that would collide; every labels each category, thinning out to every second, third and so on only when the labels cannot fit; a value or time axis has no categories, so there every acts as auto. Without it, auto."
                },
                "tick_angle": {
                  "enum": [
                    0,
                    -45,
                    -90
                  ],
                  "default": 0,
                  "description": "Rotation of the tick labels in degrees; a tilted axis grows to fit them. Without it, 0."
                }
              }
            },
            "y_axis": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "enum": [
                    "value",
                    "log"
                  ],
                  "default": "value",
                  "description": "Without it, value."
                },
                "label": {
                  "type": "string",
                  "description": "A title written along the primary y axis, outside its ticks."
                }
              }
            },
            "y_axis_secondary": {
              "type": "object",
              "additionalProperties": false,
              "description": "Settings of the secondary y axis, used by series whose y_axis is secondary.",
              "properties": {
                "type": {
                  "enum": [
                    "value",
                    "log"
                  ],
                  "default": "value",
                  "description": "Without it, value."
                },
                "label": {
                  "type": "string",
                  "description": "A title written along the secondary y axis, outside its ticks."
                },
                "unit": {
                  "type": "string",
                  "description": "Written after every tick value of the secondary axis, for example %."
                }
              }
            },
            "legend_position": {
              "enum": [
                "top",
                "right",
                "bottom",
                "left",
                "none"
              ],
              "default": "bottom",
              "description": "none hides the legend. Without it, bottom."
            },
            "value_labels": {
              "enum": [
                "auto",
                "always",
                "never"
              ],
              "default": "never",
              "description": "Values written at the end of the bars (above a bar that grows up, below one that grows down; a zero bar has none): always, never, or auto when every bar is wide enough for its value. Without it, never."
            },
            "drill_down": {
              "type": "boolean",
              "default": false,
              "description": "Whether the chart offers its data view and opens it from a click on a mark. Without it, false."
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    {
      "$id": "gts://gts.frontx.dashboard.widget.render.v1~frontx.dashboard.widget.pie_chart_render.v1~",
      "$schema": "https://json-schema.org/draft/2020-12/schema",
      "title": "PieChartRender",
