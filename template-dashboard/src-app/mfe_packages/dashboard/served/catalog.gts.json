              "maxItems": 2,
              "items": {
                "type": "string",
                "pattern": "^[0-9]{1,4}(\\.[0-9]{1,2})?(%|px)$"
              },
              "description": "Optional outer radius, or inner and outer radius, each a percentage or a pixel value, for example [\"50%\", \"70%\"] for a donut or [\"60px\"]. Two items make a donut."
            },
            "legend_position": {
              "enum": [
                "top",
                "right",
                "bottom",
                "left",
                "none"
              ],
              "default": "bottom",
              "description": "none hides the legend. Without it, bottom."
            },
            "drill_down": {
              "type": "boolean",
              "default": false,
              "description": "Whether the chart offers its data view and opens it from a click on a segment. Without it, false."
            }
          }
        }
