{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    // A product compiles the packages from source, under its own settings: these two
    // keep them free of syntax that erasableSyntaxOnly refuses and able to emit declarations.
    "erasableSyntaxOnly": true,
    "declaration": true,
    "types": [
      "vitest/globals",
      "vite/client"
    ]
  },
  "include": [
    "src-app",
    "preview",
    "host",
    "vitest.config.ts"
  ],
  "exclude": [
    "src-app/mfe_packages/*/vite.bundle.config.ts",
    "host/vite.config.ts"
  ]
}
